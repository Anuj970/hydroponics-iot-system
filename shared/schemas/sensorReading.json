{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SensorReading",
  "type": "object",
  "properties": {
    "pH": {
      "type": "number",
      "minimum": 0,
      "maximum": 14
    },
    "temperature": {
      "type": "number",
      "minimum": -40,
      "maximum": 125
    },
    "moisture": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": ["pH", "temperature", "moisture"]
}